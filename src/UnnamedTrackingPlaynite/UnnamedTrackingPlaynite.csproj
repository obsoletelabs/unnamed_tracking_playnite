<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>UnnamedTrackingPlaynite</AssemblyName>
    <RootNamespace>UnnamedTrackingPlaynite</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.17.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StampExtensionManifest" AfterTargets="Build">
    <PropertyGroup>
      <_ExtensionManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/extension.yaml'))</_ExtensionManifest>
      <_VersionedManifest>$([System.Text.RegularExpressions.Regex]::Replace('$(_ExtensionManifest)', '(?m)^Version:[^\r\n]*', 'Version: $(Version)'))</_VersionedManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)extension.yaml" Lines="$(_VersionedManifest)" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
